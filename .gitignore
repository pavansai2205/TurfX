# ==========================================
# TurfX Root .gitignore
# ==========================================

# ------------------------------------------
# Environment & Local Secrets
# ------------------------------------------
.env
.env.*
!.env.example
*.env
backend/.env
frontend/.env

# ------------------------------------------
# Node.js & React Frontend
# ------------------------------------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
frontend/build/
.next/
.nuxt/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# Python & Django Backend
# ------------------------------------------
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.python-version
.venv/
backend/.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Django Database & Static/Media uploads
*.sqlite3
*.db
*.db-journal
backend/db.sqlite3
backend/prisma/dev.db
backend/prisma/dev.db-journal
backend/staticfiles/
backend/media/

# ------------------------------------------
# Editor & IDE Configs
# ------------------------------------------
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# ------------------------------------------
# OS Metadata & Temp Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.log
